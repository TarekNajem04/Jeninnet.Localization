<Window x:Class="Jeninnet.Localization.Reference.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        FlowDirection="{Binding FlowDirection}"
        Width="760"
        Height="540"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <StackPanel
            DockPanel.Dock="Top"
            Orientation="Horizontal"
            Margin="0,0,0,12">
            <TextBlock Text="{Binding SwitchCultureLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding CultureOptions}" SelectedItem="{Binding CurrentCulture, Mode=TwoWay}" Width="264" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="{Binding CatalogHeading}" FontWeight="Bold" Margin="0,0,0,6" />
                <ListBox
                    ItemsSource="{Binding Books}"
                    SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                    DisplayMemberPath="Display"
                    Height="280" />
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding BookFieldLabel}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding SelectedBookDetails}" TextWrapping="Wrap" MinHeight="40" Margin="0,0,0,12" />
                <TextBlock Text="{Binding QuantityLabel}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Quantity}" Width="96" HorizontalAlignment="Left" />
                <Button Content="{Binding AddToOrderLabel}" Click="OnPlaceOrderClicked" Width="120" HorizontalAlignment="Left" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
