<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Jeninnet.Localization.Reference.Maui.MainPage">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">
            <Label x:Name="TitleText"
                   Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label x:Name="WelcomeText"
                   Style="{StaticResource SubHeadline}" />
            <HorizontalStackLayout Spacing="12">
                <Label x:Name="CultureLabel" VerticalOptions="Center" />
                <Picker x:Name="CultureSelector"
                        MinimumWidthRequest="180"
                        SelectedIndexChanged="OnCultureChanged" />
            </HorizontalStackLayout>
            <Label x:Name="StatusText" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
