<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <OutputType>WinExe</OutputType>
        <RootNamespace>Jeninnet.Localization.Reference.WinUI</RootNamespace>
        <UseWinUI>true</UseWinUI>
        <WindowsPackageType>None</WindowsPackageType>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <Platforms>x64</Platforms>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
        <PackageReference Include="Microsoft.WindowsAppSDK" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\integrations\Jeninnet.Localization.Integrations.WinUI\Jeninnet.Localization.Integrations.WinUI.csproj" />
        <ProjectReference Include="..\Jeninnet.Localization.HostSamples.Shared\Jeninnet.Localization.HostSamples.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\Jeninnet.Localization.HostSamples.Shared\Localization\*.json"
                 Link="Localization\%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
