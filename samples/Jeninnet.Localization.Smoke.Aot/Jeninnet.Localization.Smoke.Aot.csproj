<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <!-- Packaged as Exe for the AOT smoke matrix: publish + run per TFM. -->
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <IsAotCompatible>true</IsAotCompatible>
        <PublishAot>true</PublishAot>
        <!--
            .NET 10 no longer implies self-contained for `dotnet publish -r <rid>`;
            Native AOT requires it, so pin it whenever a runtime identifier is given.
        -->
        <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
        <InvariantGlobalization>false</InvariantGlobalization>
        <!-- The RID-specific content layout of an AOT publish does not carry the doc file. -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Options" />
        <!-- Pinned past CVE-2026-111497 (GHSA-p3jp-9v83-76w9): the SDK-resolved 10.0.8 compiler is vulnerable; the explicit reference wins the version conflict. -->
        <PackageReference Include="Microsoft.DotNet.ILCompiler" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Jeninnet.Localization.Core\Jeninnet.Localization.Core.csproj" />
        <ProjectReference Include="..\..\src\providers\Jeninnet.Localization.Providers.Memory\Jeninnet.Localization.Providers.Memory.csproj" />
        <ProjectReference Include="..\..\src\translation\Jeninnet.Localization.Translation.Azure\Jeninnet.Localization.Translation.Azure.csproj" />
    </ItemGroup>

</Project>
