<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(ReferenceLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(ReferenceLayout)">
            <p>Not Found</p>
        </LayoutView>
    </NotFound>
</Router>