<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <UserSecretsId>jeninnet-localization-reference-blazorserver</UserSecretsId>
        <!--
            S8970: the Razor source generator emits null-forgiving operators inside a
            #nullable-disable context (.decl.g.cs). The finding is not actionable for
            machine-generated code, and per-tree .editorconfig severity is not applied to
            source-generated trees, so the rule is suppressed for this project.
        -->
        <NoWarn>$(NoWarn);S8970</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\integrations\Jeninnet.Localization.Integrations.Blazor\Jeninnet.Localization.Integrations.Blazor.csproj" />
        <ProjectReference Include="..\Jeninnet.Localization.Reference.Shared\Jeninnet.Localization.Reference.Shared.csproj" />
    </ItemGroup>
</Project>