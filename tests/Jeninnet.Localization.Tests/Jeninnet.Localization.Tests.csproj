<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!--
            MSB3277: the Roslyn workspaces assemblies (test-only code-fix tests) carry an
            assembly reference to SQLitePCLRaw.core 3.0.2 for their SQLite-backed storage
            layer, while the EF Core SQLite stack in this closure provides 2.1.13 (the
            primary, working version). The conflict resolves to 2.1.13 and is proven benign:
            the EF/SQLite store tests and every AdhocWorkspace code-fix test run green, and
            the workspace SQLite storage is never exercised here. Demoted to a message so
            the resolution notice does not mask real warnings.
        -->
        <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="MSTest" />
        <PackageReference Include="MSTest.TestAdapter" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <!-- Coverage collector for the XPlat Code Coverage data collector (scripts/coverage, SonarCloud). Test-only. -->
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Jeninnet.Assertions" />
        <!-- Roslyn workspaces:  code-fix end-to-end tests (AdhocWorkspace). Test-only. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
        <!-- EF Core SQLite provider: deterministic  resource-admin store tests (in-memory/shared-cache). Test-only; never packed. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
        <!-- Required at build and runtime for the non-string SatelliteFixture entry (strings-only contract pin). -->
        <PackageReference Include="System.Resources.Extensions" />
    </ItemGroup>

