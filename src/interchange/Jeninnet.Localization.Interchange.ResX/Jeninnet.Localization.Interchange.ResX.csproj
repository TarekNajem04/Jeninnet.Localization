<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(RuntimeTargetFrameworks)</TargetFrameworks>
    </PropertyGroup>

    <!--
        ResX catalog interchange for the ResX editor/translator
        ecosystem. Tooling only — files are interchange, never a runtime source.
        The classic BCL ResXResourceWriter/ResXResourceReader are Windows-Desktop-only
        on net10.0 (System.Windows.Forms), so this package ships a hand-rolled
        canonical ResX 2.0 writer/reader (strings + comments) on BCL System.Xml only;
        it references the shared interchange contract project (status vocabulary +
        internal catalog file codec) and nothing else.
    -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Jeninnet.Localization.Interchange.Abstractions\Jeninnet.Localization.Interchange.Abstractions.csproj" />
    </ItemGroup>

</Project>
