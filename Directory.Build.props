<Project>

    <PropertyGroup>
        <!--
        Single supported runtime: .NET 10 LTS (supported through November 2028).
        net8.0/net9.0 reached end of support in November 2026; 1.0 ships net10-only.
        -->
        <RuntimeTargetFrameworks>net10.0</RuntimeTargetFrameworks>
        <LangVersion>14.0</LangVersion>
        <!--<OutputPath>$(SolutionDir)output</OutputPath>-->

        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <NuGetAuditLevel>low</NuGetAuditLevel>
        <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UseNETCoreGenerator>true</UseNETCoreGenerator>
        <!--
            CS1591: C# Missing XML comment for publicly visible type or member
            CS1701 && CS1702: Assuming assembly reference "Assembly Name #1" matches "Assembly Name #2", you may need to supply runtime policy
            CA1016: Mark assemblies with AssemblyVersionAttribute
            CA2012: Use ValueTasks correctly
            CA1591: Missing XML comment for publicly visible type or member
            <NoWarn>$(NoWarn);1701;1702;1016;2012;</NoWarn>
        -->

        <!--
            https://www.tabsoverspaces.com/233608-stopping-msbuild-appending-targetframework-to-outputpath
            Stopping MSBuild appending TargetFramework to OutputPath
        -->
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

        <!--
            Utilize the documentation file in Open Api.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DocumentationFile>$(MSBuildProjectName).xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SonarAnalyzer.CSharp">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.SourceLink.GitHub">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <PropertyGroup>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <!--<AnalysisMode>recommended</AnalysisMode>-->
        <AnalysisMode>recommended</AnalysisMode>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <!--
        Trim + Native AOT analyzers for every packable runtime library project.
        The netstandard2.0 tooling projects (Generators.Keys, Analyzers.Localizability*)
        cannot carry the trim/AOT contract, and the samples/tests/consumers trees are
        consumers outside it.
    -->
    <PropertyGroup Condition="'$(TargetFramework)' == '' And '$(TargetFrameworks)' == '' And ($(MSBuildProjectDirectory.Contains('samples')) Or $(MSBuildProjectDirectory.Contains('tests')) Or $(MSBuildProjectDirectory.Contains('consumers'))) And '$(MSBuildProjectName)' != 'Jeninnet.Localization.Tests'">
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <PropertyGroup Condition="!$(MSBuildProjectDirectory.Contains('samples')) And !$(MSBuildProjectDirectory.Contains('tests')) And !$(MSBuildProjectDirectory.Contains('consumers')) And !$(MSBuildProjectName.Contains('Analyzers')) And '$(MSBuildProjectName)' != 'Jeninnet.Localization.Generators.Keys' And '$(MSBuildProjectName)' != 'Jeninnet.Localization.Tools.Keys'">
        <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('samples')) Or $(MSBuildProjectDirectory.Contains('tests')) Or $(MSBuildProjectDirectory.Contains('consumers')) Or $(MSBuildProjectName.Contains('Analyzers')) Or '$(MSBuildProjectName)' == 'Jeninnet.Localization.Generators.Keys' Or '$(MSBuildProjectName)' == 'Jeninnet.Localization.Tools.Keys'">
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <PropertyGroup Condition="!$(MSBuildProjectDirectory.Contains('samples')) And !$(MSBuildProjectDirectory.Contains('tests')) And !$(MSBuildProjectDirectory.Contains('consumers')) And !$(MSBuildProjectName.Contains('Analyzers')) And '$(MSBuildProjectName)' != 'Jeninnet.Localization.Generators.Keys' And '$(MSBuildProjectName)' != 'Jeninnet.Localization.Tools.Keys'">
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <Authors>Tarek Najem</Authors>
        <Copyright>Copyright © Jeninnet</Copyright>
        <NeutralLanguage>nl-NL</NeutralLanguage>
        <Description>$(MSBuildProjectName) - a component of Jeninnet.Localization, a modular localization framework for .NET. See the package README for scope and usage.</Description>
        <PackageTags>localization;internationalization;i18n;l10n;dotnet</PackageTags>

        <!--
            Single solution-wide product version (the project identity rule).
            ProjectName == AssemblyName == RootNamespace == PackageId.
            Projects must NOT declare their own <Version>.
            AssemblyVersion and FileVersion must stay numeric because they cannot carry a prerelease label.
        -->
        <Version>1.0.0-preview.1</Version>

        <FileVersion>1.0.0.0</FileVersion>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <PackageVersion>$(Version)</PackageVersion>

        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>jeninnet-localization-icon.png</PackageIcon>
        <PackageId>$(MSBuildProjectName)</PackageId>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/TarekNajem04/Jeninnet.Localization</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <PackageReleaseNotes>See CHANGELOG.md in the repository.</PackageReleaseNotes>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <!-- Set the minimum NuGet client version required to install this package -->
        <MinClientVersion>7.3.0</MinClientVersion>
    </PropertyGroup>

    <!--
        Per-package descriptions and search tags (ROADMAP: per-package descriptions and tags).
        The generic fallback above stays for any future package; each shipped package carries a
        meaningful description and targeted tags. Conditions key on the project identity rule
        (PackageId == MSBuildProjectName).
    -->
    <PropertyGroup>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization'">The Jeninnet.Localization discoverability package: the canonical localization pipeline (contracts, localizer, and resource-set storage). Add exactly one message provider for a working localizer.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization'">localization;internationalization;i18n;l10n;dotnet;metapackage;discoverability</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Abstractions'">Contracts for the Jeninnet.Localization pipeline: message providers, localizers, formatters, plural rules, diagnostics, and the resource-set store.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Abstractions'">localization;i18n;l10n;contracts;abstractions;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Core'">The Jeninnet.Localization runtime pipeline: localizer, default and ICU formatters, provider selector, store-backed IStringLocalizer bridge, and DI registration.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Core'">localization;i18n;l10n;localizer;icu;formatter;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Storage'">Canonical message data models shared by Jeninnet.Localization file providers and tooling.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Storage'">localization;i18n;storage;models;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Memory'">In-memory message provider for Jeninnet.Localization: one immutable dictionary for tests, prototypes, and WASM hosts.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Memory'">localization;i18n;provider;inmemory;memory;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Json'">JSON file message provider for Jeninnet.Localization: flat JSON catalogs with opt-in hot reload.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Json'">localization;i18n;provider;json;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Ini'">INI file message provider for Jeninnet.Localization: flat key=value catalogs with optional sections and opt-in hot reload.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Ini'">localization;i18n;provider;ini;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Xml'">XML file message provider for Jeninnet.Localization: flat XML catalogs with opt-in hot reload.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Xml'">localization;i18n;provider;xml;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.ResX'">ResX message provider for Jeninnet.Localization: embedded .resx resources via ResourceManager with exact-culture lookup.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.ResX'">localization;i18n;provider;resx;resources;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Satellite'">Satellite message provider for Jeninnet.Localization: compiled neutral resources plus satellite packs.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Satellite'">localization;i18n;provider;satellite;resources;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Po'">Gettext PO/MO message provider for Jeninnet.Localization: contexts and plural tables with opt-in hot reload.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Po'">localization;i18n;provider;gettext;po;mo;plural;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Pseudo'">Pseudo-localization provider for Jeninnet.Localization: synthetic culture for overflow and leak detection.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Pseudo'">localization;i18n;provider;pseudo;testing;qa;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Database.Abstractions'">Shared base types for the Jeninnet.Localization ADO.NET database message providers.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Database.Abstractions'">localization;i18n;provider;database;abstractions;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Database.SqlServer'">SQL Server message provider for Jeninnet.Localization: reads the LocalizationMessages table.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Database.SqlServer'">localization;i18n;provider;sqlserver;database;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Database.MySql'">MySQL message provider for Jeninnet.Localization: reads the LocalizationMessages table.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Database.MySql'">localization;i18n;provider;mysql;database;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Database.PostgreSQL'">PostgreSQL message provider for Jeninnet.Localization: reads the LocalizationMessages table.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Database.PostgreSQL'">localization;i18n;provider;postgresql;database;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Database.SQLite'">SQLite message provider for Jeninnet.Localization: reads the LocalizationMessages table.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Database.SQLite'">localization;i18n;provider;sqlite;database;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Database.EntityFrameworkCore'">EF Core resource-set store for Jeninnet.Localization: administered sets with audit, history, notes, and synchronization over SQL Server.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Providers.Database.EntityFrameworkCore'">localization;i18n;efcore;store;admin;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Translation.Azure'">Azure Translator provider for Jeninnet.Localization: cached, batched, resilient machine translation with glossary and translation memory.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Translation.Azure'">localization;i18n;translation;azure;translator;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Translation.DeepL'">DeepL machine translation provider for Jeninnet.Localization: cached, batched, resilient translation with glossary and translation memory.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Translation.DeepL'">localization;i18n;translation;deepl;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Translation.Google'">Google Translate provider for Jeninnet.Localization: minimal single-key machine translation.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Translation.Google'">localization;i18n;translation;google;translate;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Integrations.Avalonia'">Avalonia host integration for Jeninnet.Localization: culture service, file persistence, and RTL helpers.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Integrations.Avalonia'">localization;i18n;avalonia;desktop;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Integrations.Blazor'">Blazor host integration for Jeninnet.Localization: circuit and WASM culture management.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Integrations.Blazor'">localization;i18n;blazor;aspnetcore;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Integrations.DataAnnotations'">Localized DataAnnotations for Jeninnet.Localization: validation attributes resolved through IStringLocalizer.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Integrations.DataAnnotations'">localization;i18n;dataannotations;validation;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Integrations.Diagnostics'">Diagnostics integration for Jeninnet.Localization: provider and store health checks.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Integrations.Diagnostics'">localization;i18n;diagnostics;healthchecks;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Integrations.JavaScript'">JavaScript resource delivery for Jeninnet.Localization: versioned endpoint and static export with ETags.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Integrations.JavaScript'">localization;i18n;javascript;aspnetcore;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Integrations.Mvc.Validation'">MVC validation integration for Jeninnet.Localization: metadata, HTML-safe localizers, view localization, and the loc tag helper.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Integrations.Mvc.Validation'">localization;i18n;mvc;validation;aspnetcore;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Integrations.RequestLocalization'">Request-localization bridge for Jeninnet.Localization: builds request culture options from the store.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Integrations.RequestLocalization'">localization;i18n;requestlocalization;aspnetcore;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Integrations.Maui'">MAUI host integration for Jeninnet.Localization: culture service with preferences persistence.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Integrations.Maui'">localization;i18n;maui;mobile;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Integrations.WinUI'">WinUI 3 host integration for Jeninnet.Localization: culture service with application-data persistence.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Integrations.WinUI'">localization;i18n;winui;windows;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Interchange.Abstractions'">Shared contracts for the Jeninnet.Localization catalog interchange family.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Interchange.Abstractions'">localization;i18n;interchange;abstractions;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Interchange.Csv'">CSV catalog interchange for Jeninnet.Localization: RFC 4180 export and validate-then-apply import.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Interchange.Csv'">localization;i18n;interchange;csv;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Interchange.Po'">PO catalog interchange for Jeninnet.Localization: gettext export and import for translator workflows.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Interchange.Po'">localization;i18n;interchange;gettext;po;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Interchange.ResX'">ResX catalog interchange for Jeninnet.Localization: canonical ResX 2.0 export and import.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Interchange.ResX'">localization;i18n;interchange;resx;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Interchange.Xliff'">XLIFF 2.0 catalog interchange for Jeninnet.Localization: vendor export and import.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Interchange.Xliff'">localization;i18n;interchange;xliff;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Generators.Keys'">Roslyn source generator for Jeninnet.Localization: strongly typed key constants from loc.json catalogs.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Generators.Keys'">localization;i18n;roslyn;generator;sourcegenerator;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Analyzers.Localizability'">Roslyn analyzer for Jeninnet.Localization: flags hardcoded user-facing strings (JLNLOC001) with a code fix.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Analyzers.Localizability'">localization;i18n;roslyn;analyzer;dotnet</PackageTags>
        <Description Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Tools.Keys'">Catalog parity CLI for Jeninnet.Localization: key extraction and missing/unused/placeholder-drift checks.</Description>
        <PackageTags Condition="'$(MSBuildProjectName)' == 'Jeninnet.Localization.Tools.Keys'">localization;i18n;cli;tool;parity;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)LICENSE">
            <Pack>true</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md">
            <Pack>true</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="$(MSBuildProjectDirectory)\README.md">
            <Pack>true</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="$(MSBuildThisFileDirectory)assets\jeninnet-localization-icon.png">
            <Pack>true</Pack>
            <PackagePath>\</PackagePath>
            <Visible>false</Visible>
        </None>
        <!--
        <None Include="$(SolutionDir)output\**\*">
            <Link>output\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <Pack>false</Pack>
            <Visible>true</Visible>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
        -->

    </ItemGroup>

    <!--
    https://learn.microsoft.com/en-us/dotnet/csharp/language-reference/compiler-options/errors-warnings#warninglevel
    WarningLevel
    The WarningLevel option specifies the warning level for the compiler to display.
    ===========================================================================================================================================================
    ‖ Warning level	‖ Meaning                                                                                                                                 ‖
    ===========================================================================================================================================================
    ‖ 0	            ‖ Turns off emission of all warning messages.                                                                                             ‖
    ‖ 1	            ‖ Displays severe warning messages.                                                                                                       ‖
    ‖ 2	            ‖ Displays level 1 warnings plus certain, less-severe warnings, such as warnings about hiding class members.                              ‖
    ‖ 3	            ‖ Displays level 2 warnings plus certain, less-severe warnings, such as warnings about expressions that always evaluate to true or false. ‖
    ‖ 4 (default)	‖ Displays all level 3 warnings plus informational warnings.                                                                              ‖
    ===========================================================================================================================================================
    -->
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <WarningLevel>9999</WarningLevel>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <WarningLevel>9999</WarningLevel>
    </PropertyGroup>

    <!--
        We don't follow Arcade conventions for project naming.
    -->
    <PropertyGroup Condition="'$(IsUnitTestProject)' == ''">
        <IsUnitTestProject>false</IsUnitTestProject>
        <IsUnitTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsUnitTestProject>
        <!-- Ensure this line copies the test result files to a unified folder in the root of the Solution -->
        <VSTestResultsDirectory>$(MSBuildThisFileDirectory)TestResults</VSTestResultsDirectory>
    </PropertyGroup>

    <PropertyGroup>
        <IsSampleProject Condition="$(MSBuildProjectName.Contains('.Sample.'))">true</IsSampleProject>
        <IsNonShippingProject Condition="$(MSBuildProjectName.EndsWith('.Benchmarks'))">true</IsNonShippingProject>
    </PropertyGroup>

    <PropertyGroup>
        <NoWarn Condition="'$(IsUnitTestProject)' == 'true' Or '$(IsSampleProject)' == 'true' Or '$(IsNonShippingProject)' == 'true'">$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <!-- Local NuGet feed for analyzer package -->
    <PropertyGroup>
        <!-- Where the local feed lives (relative to solution root) -->
        <LocalArtifacts>$(MSBuildThisFileDirectory)artifacts\</LocalArtifacts>
    </PropertyGroup>

    <PropertyGroup Condition="'$(DisableArtifacts)' != 'true'">
        <!-- Add local feed as an extra restore source -->
        <!--<RestoreSources>$(RestoreSources);$(LocalArtifacts)</RestoreSources>-->
    </PropertyGroup>

</Project>
