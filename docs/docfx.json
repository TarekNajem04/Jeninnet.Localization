  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.md",
          "ar/toc.yml",
          "toc.yml"
        ],
        "exclude": [
          "_site/**",
          "api/**"
        ]
      },
      {
        "files": [
          "api/*.yml",
          "api/**/*.yml",
          "api/index.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "docfx.json",
          "database/**/*.sql",
          "styles/**"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appTitle": "Jeninnet.Localization",
      "_appFooter": "<span>Jeninnet.Localization — modular localization for .NET</span><script>(function(){var a=/\\/ar(\\/|$)/.test(location.pathname);document.documentElement.lang=a?'ar':'en';document.documentElement.dir=a?'rtl':'ltr';})();</script>",
      "_enableSearch": true,
      "_disableContribution": true
    },
    "template": [
      "default"
    ]
  }
}
