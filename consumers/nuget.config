<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- The packed solution. artifacts/ is populated by `dotnet pack` (see README.md). -->
    <add key="jeninnet-localization.local" value="../artifacts" />
  </packageSources>
  <config>
    <!--
      The consumer restore uses its own global-packages folder: the solution version is
      constant (1.0.0) while the packed content changes on every pack, and NuGet trusts an
      already-extracted package in the shared machine-wide folder. The pack hook in
      Directory.Build.targets invalidates this folder after every pack, so the consumers
      always validate the freshly packed packages.
    -->
    <add key="globalPackagesFolder" value="../artifacts/consumer-packages" />
  </config>
</configuration>
